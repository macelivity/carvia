# Tarif Endpoints

@host = http://127.0.0.1:5000
@baseUrl = {{host}}/api

###

# Get all Tarife
GET {{baseUrl}}/tarife

###

# Create a new Tarif
POST {{baseUrl}}/tarife
Content-Type: application/json

{
  "Name": "Basic Tarif",
  "Freikilometer": 100,
  "Versicherungsschutz": "Vollkasko"
}

###

# Create another Tarif
POST {{baseUrl}}/tarife
Content-Type: application/json

{
  "Name": "Premium Tarif",
  "Freikilometer": 500,
  "Versicherungsschutz": "Vollkasko Plus"
}

###

# Get specific Tarif by ID
GET {{baseUrl}}/tarife/1

###

# Update specific Tarif
PUT {{baseUrl}}/tarife/1
Content-Type: application/json

{
  "Name": "Basic Tarif Updated",
  "Freikilometer": 150,
  "Versicherungsschutz": "Teilkasko"
}

###

# Delete specific Tarif
DELETE {{baseUrl}}/tarife/2
