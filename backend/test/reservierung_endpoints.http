### Reservierung Endpoints

# Get all Reservierungen
GET http://127.0.0.1:5000/api/reservations/

###

# Create a new Reservierung
POST http://127.0.0.1:5000/api/reservations/
Content-Type: application/json

{
  "FahrzeugID": 1,
  "UserID": 1,
  "RechnungID": 1,
  "TarifID": 1,
  "StartDatum": "2024-12-10",
  "EndDatum": "2024-12-12",
  "Abholort": "Berlin",
  "Rueckgabeort": "Berlin"
}

###

# Create another Reservierung
POST http://127.0.0.1:5000/api/reservations/
Content-Type: application/json

{
  "FahrzeugID": 2,
  "UserID": 1,
  "RechnungID": 2,
  "TarifID": 1,
  "StartDatum": "2024-12-15",
  "EndDatum": "2024-12-17",
  "Abholort": "Berlin",
  "Rueckgabeort": "Hamburg"
}

###

# Get specific Reservierung by ID
GET http://127.0.0.1:5000/api/reservations/1

###

# Update specific Reservierung
PUT http://127.0.0.1:5000/api/reservations/1
Content-Type: application/json

{
  "FahrzeugID": 1,
  "UserID": 1,
  "RechnungID": 1,
  "TarifID": 2,
  "StartDatum": "2024-12-10",
  "EndDatum": "2024-12-13"
}

###

# Get all Reservierungen for a specific User
GET http://127.0.0.1:5000/api/reservations/user/1

###

# Get all Reservierungen for a specific Fahrzeug
GET http://127.0.0.1:5000/api/reservations/fahrzeug/1

###

# Delete specific Reservierung
DELETE http://127.0.0.1:5000/api/reservations/2
