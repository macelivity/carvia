# Modell Endpoints

@host = http://127.0.0.1:5000
@baseUrl = {{host}}/api


###

# GET all modells
GET {{baseUrl}}/modell/

###

# POST create new modell
POST {{baseUrl}}/modell/
Content-Type: application/json

{
  "ModellName": "Golf 8",
  "Hersteller": "Volkswagen",
  "Fahrzeugtyp": "Kompaktwagen",
  "Getriebeart": "Manuell",
  "Kraftstoffart": "Benzin",
  "Leistung": 150,
  "Türen": 5,
  "Sitze": 5,
  "Kofferraumvolumen": 380,
  "Stundenpreis": 25.50
}

###

# GET specific modell
GET {{baseUrl}}/modell/1

###

# PUT update modell
PUT {{baseUrl}}/modell/1
Content-Type: application/json

{
  "ModellName": "Golf GTI",
  "Hersteller": "Volkswagen",
  "Fahrzeugtyp": "Kompaktwagen",
  "Getriebeart": "Automatik",
  "Kraftstoffart": "Benzin",
  "Leistung": 245,
  "Türen": 5,
  "Sitze": 5,
  "Kofferraumvolumen": 380,
  "Stundenpreis": 35.00
}

###

# DELETE modell
DELETE {{baseUrl}}/modell/13

