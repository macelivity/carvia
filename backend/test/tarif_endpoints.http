# Tarif Endpoints

@host = http://127.0.0.1:5000
@baseUrl = {{host}}/api

###

# Get all Tarife
GET {{baseUrl}}/tarif

###

# Create a new Tarif
POST {{baseUrl}}/tarif
Content-Type: application/json

{
  "Name": "Basis Tarif",
  "Freikilometer": 100,
  "Versicherungsschutz": "Teilkasko",
  "Multiplikator": 1.0
}

###

# Create another Tarif
POST {{baseUrl}}/tarif
Content-Type: application/json

{
  "Name": "Premium Tarif",
  "Freikilometer": 500,
  "Versicherungsschutz": "Vollkasko Plus",
  "Multiplikator": 1.5
}

###

# Get specific Tarif by ID
GET {{baseUrl}}/tarif/1

###

# Update specific Tarif
PUT {{baseUrl}}/tarif/1
Content-Type: application/json

{
  "Name": "Basic Tarif Updated",
  "Freikilometer": 150,
  "Versicherungsschutz": "Teilkasko"
}

###

# Delete specific Tarif
DELETE {{baseUrl}}/tarif/2
