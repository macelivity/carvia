# Rechnung Endpoints

@host = http://127.0.0.1:5000
@baseUrl = {{host}}/api


###

# Get all Rechnungen
GET {{baseUrl}}/rechnung/

###

# Create a new Rechnung
POST {{baseUrl}}/rechnung/
Content-Type: application/json

{
  "FahrzeugID": 1,
  "Bezahlt": 0,
  "Austellungsdatum": "2024-12-06"
}

###

# Create another Rechnung
POST {{baseUrl}}/rechnung/
Content-Type: application/json

{
  "FahrzeugID": 2,
  "Bezahlt": 1,
  "Austellungsdatum": "2024-12-05"
}

###

# Get specific Rechnung by ID
GET {{baseUrl}}/rechnung/1

###

# Update specific Rechnung (mark as paid)
PUT {{baseUrl}}/rechnung/1
Content-Type: application/json

{
  "FahrzeugID": 1,
  "Bezahlt": 1,
  "Austellungsdatum": "2024-12-06"
}

###

# Get all Rechnungen for a specific Fahrzeug
GET {{baseUrl}}/rechnung/fahrzeug/1

###

# Delete specific Rechnung
DELETE {{baseUrl}}/rechnung/2
