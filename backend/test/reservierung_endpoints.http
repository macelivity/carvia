### Reservierungs Endpoints

# Basis-URL für die API (kann bei Bedarf angepasst werden)
@baseUrl = http://127.0.0.1:5000/api/reservations

###
# POST: Erstellt eine neue Reservierung
# Felder basierend auf reservierung_routes.py
# Annahme: UserID 1 und FahrzeugID 1 existieren.
# Datumsformat: ISO 8601 (YYYY-MM-DDTHH:MM:SS)
POST {{baseUrl}}/
Content-Type: application/json

{
  "UserID": 1,
  "FahrzeugID": 1,
  "Reservierungsbeginn": "2025-08-01T10:00:00",
  "Reservierungsende": "2025-08-01T12:00:00",
  "RechnungID": 1,
  "TarifID": 1
}

###
# POST: Erstellt eine weitere Reservierung (minimal erforderlich)
POST {{baseUrl}}/
Content-Type: application/json

{
  "UserID": 2,
  "FahrzeugID": 1,
  "Reservierungsbeginn": "2025-08-02T14:00:00",
  "Reservierungsende": "2025-08-02T18:00:00",
  "RechnungID": 2,
  "TarifID": 3
}

###
# GET: Ruft alle Reservierungen ab
GET {{baseUrl}}/

###
# GET: Ruft eine spezifische Reservierung ab (z.B. mit ID 1)
# Ersetze '1' mit einer existierenden ReservierungsID
GET {{baseUrl}}/1

###
# PUT: Aktualisiert eine bestehende Reservierung (z.B. mit ID 1)
# Ersetze '1' mit einer existierenden ReservierungsID
# Alle Felder sind optional.
PUT {{baseUrl}}/1
Content-Type: application/json

{
  "Reservierungsbeginn": "2025-08-01T10:30:00", 
  "Reservierungsende": "2025-08-01T13:00:00"
}


###
# DELETE: Löscht eine Reservierung (z.B. mit ID 2)
# Ersetze '2' mit einer existierenden ReservierungsID
DELETE {{baseUrl}}/2

###
# Testfall: Fehlende erforderliche Felder beim Erstellen
POST {{baseUrl}}/
Content-Type: application/json

{
  "UserID": 1,
  "Reservierungsbeginn": "2025-08-03T10:00:00"
  // FahrzeugID und Reservierungsende fehlen
}

###
# Testfall: Ungültiges Datumsformat
POST {{baseUrl}}/
Content-Type: application/json

{
  "UserID": 1,
  "FahrzeugID": 1,
  "Reservierungsbeginn": "03-08-2025 10:00", 
  "Reservierungsende": "03-08-2025 12:00"
}